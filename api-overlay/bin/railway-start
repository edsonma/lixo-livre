#!/usr/bin/env bash
# Container start command: prepares the database, optionally loads demo data, starts the server.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -z "${SECRET_KEY_BASE:-}" ]; then
  echo "SECRET_KEY_BASE is not set. Generate one with:  openssl rand -hex 64" >&2
  exit 1
fi
# No DATABASE_URL but the standard PG* variables are there: build the URL from them. The user and
# password are percent-encoded, so a password with @ # / : or spaces cannot break the URL.
if [ -z "${DATABASE_URL:-}" ] && [ -n "${PGHOST:-}" ]; then
  DATABASE_URL=$(ruby -ruri -e '
    userinfo = [ENV.fetch("PGUSER", "postgres"), ENV.fetch("PGPASSWORD", "")].map { |part| URI.encode_uri_component(part) }.join(":")
    puts "postgres://#{userinfo}@#{ENV.fetch("PGHOST")}:#{ENV.fetch("PGPORT", "5432")}/#{ENV.fetch("PGDATABASE", "postgres")}"
  ')
  export DATABASE_URL
fi

if [ -z "${DATABASE_URL:-}" ]; then
  echo "DATABASE_URL is not set. Add a PostGIS database and reference its connection URL" >&2
  echo "(or set PGHOST, PGPORT, PGUSER, PGPASSWORD and PGDATABASE)." >&2
  exit 1
fi

# Validate it (and clean stray spaces or quotes) before Rails boots, so a bad value gets a clear message
# instead of a stack trace from inside Rails.
DATABASE_URL=$(ruby bin/check_database_url) || exit 1
export DATABASE_URL

echo "==> Preparing the database (migrations)"
if ! bin/rails db:prepare; then
  target=$(ruby -ruri -e 'u = URI.parse(ENV.fetch("DATABASE_URL")); print "#{u.host}:#{u.port}"')
  {
    echo ""
    echo "==> Could not prepare the database at $target"
    case "$target" in
      *.up.railway.app*|*.proxy.rlwy.net*|*.rlwy.net*)
        echo "That is a PUBLIC Railway address. Postgres does not answer on a public domain, and a TCP proxy"
        echo "uses its own port, not 5432. Inside Railway, use the private address of the database service:"
        echo "  host: <database-service-name>.railway.internal   port: 5432"
        ;;
      *)
        echo "Checklist:"
        echo "  - the host is the database service's private name (<service>.railway.internal), spelled exactly"
        echo "  - the database service is running (green) and in the same project and environment"
        echo "  - the port is 5432, the user and password match what the database was first created with"
        echo "  - the database service has a volume with PGDATA=/var/lib/postgresql/data/pgdata"
        ;;
    esac
  } >&2
  exit 1
fi

if [ "${SEED_DEMO_DATA:-}" = "true" ]; then
  echo "==> Loading demo data (skipped if there are already reports)"
  bin/rails demo:seed
fi

if [ "${DEMO_MODE:-}" = "true" ]; then
  echo "==> DEMO MODE: fake AI, no face/plate detection. Do not use with real users."
fi

echo "==> Starting the server on port ${PORT:-3000}"
exec bin/rails server -b 0.0.0.0 -p "${PORT:-3000}"
